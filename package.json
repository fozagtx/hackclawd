{
  "name": "hackclawd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/eve/bin/eve.js dev",
    "build": "eve build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/box-runner.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "switch:register": "node --env-file-if-exists=.env --import tsx scripts/switch-register.ts",
    "local": "node --env-file-if-exists=.env --import tsx scripts/local.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@upstash/box": "0.7.10",
    "ai": "^7.0.137",
    "eve": "1.0.0-rc.1",
    "ws": "^8.18.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.1"
  }
}

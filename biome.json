{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
      "!package-lock.json",
      "!agent/instructions.md",
      "!agent/skills/secgin/SKILL.md",
      "!agent/skills/secgin/references",
      "!references/SECGIN-LICENSE",
      "!.eve",
      "!.output",
      "!node_modules",
      "!.data"
    ]
  }
}
